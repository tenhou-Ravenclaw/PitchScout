{
  "permissions": {
    "allow": [
      "WebSearch",
      "mcp__sequential-thinking__sequentialthinking",
      "mcp__ide__getDiagnostics",
      "Bash(brew upgrade:*)",
      "Bash(npm update:*)",
      "Bash(ls /Users/kanade/Desktop/PitchScout/backend/venv/bin/python*)",
      "Bash(/Users/kanade/Desktop/PitchScout/backend/venv/bin/python -c \"import sys; print\\(sys.executable\\)\")",
      "Bash(/Users/kanade/Desktop/PitchScout/backend/venv/bin/pip install:*)",
      "Bash(/Users/kanade/Desktop/PitchScout/backend/venv/bin/python:*)",
      "Bash(/Users/kanade/Desktop/PitchScout/backend/venv/bin/pip list:*)",
      "Bash(python3:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Bash(cat **/.env*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f *)",
      "Bash(*git reset --hard*)",
      "Bash(*--no-verify*)"
    ]
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "serena",
        "serena",
        "start-mcp-server"
      ]
    }
  }
}
