# Supabase設定
SUPABASE_URL=https://your-project.supabase.co
# Backend only. Use a key allowed to write user_profiles / analysis_history / favorites.
# If you use service_role, never expose it to frontend or commit backend/.env.
SUPABASE_KEY=your-backend-supabase-key-here

# セキュリティ設定（本番環境では強力な秘密鍵を使用）
JWT_SECRET=<generated-secret>

# 重い音声解析の同時実行数（プロセスごと）
MAX_CONCURRENT_VOICE_ANALYSES=2
MAX_CONCURRENT_KARAOKE_ANALYSES=1

# ユーザー音声を含むデバッグ WAV 保存。本番は false のままにする。
PITCHSCOUT_SAVE_DEBUG_AUDIO=false
